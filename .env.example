# Copy this file to .env and fill in your real values.
# .env itself should NEVER be committed to git — only .env.example should be.

# Get a free key at https://aistudio.google.com/app/apikey
# Leave blank to run the whole project in rule-based fallback mode
# (every module still works and produces real output without this key).
GEMINI_API_KEY=

# SQLite database file path (created automatically on first run)
DB_PATH=placement.db
